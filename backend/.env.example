# Lumyra Backend Environment Variables (Example Template)
# Copy to .env for local development with your actual secrets. Never commit .env.

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# PostgreSQL Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://lumyra_user:lumyra_secret@localhost:5432/lumyra_db?schema=public"

# Firebase Admin SDK Credentials
# Either provide path to service-account.json or set FIREBASE_PROJECT_ID
FIREBASE_PROJECT_ID="lumyra-health-dev"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@lumyra-health-dev.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# JWT / Mock Auth for Automated Testing
# When set to 'true', enables safe local mock token verification for testing
ALLOW_MOCK_AUTH=false

# Object Storage Configuration (Private Medical Scans)
# S3 / GCS / MinIO Compatible
STORAGE_PROVIDER="mock-local"
STORAGE_BUCKET_NAME="lumyra-private-scans"
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="me-central1"
STORAGE_ACCESS_KEY="minio_access_key_placeholder"
STORAGE_SECRET_KEY="minio_secret_key_placeholder"
STORAGE_SIGNED_URL_EXPIRY_SECONDS=900

# Pluggable AI Integration (Model-Agnostic - Deferred in Phase 3)
# Keep provider as 'mock' during local development and testing
AI_ASSISTANT_PROVIDER="mock"
MEDICAL_VISION_PROVIDER="mock"
RISK_MODEL_PROVIDER="mock"

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
